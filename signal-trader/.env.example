# ============================================================================
# Signal-Trader -- ornek ortam dosyasi. ".env" olarak kopyalayin. .env'i COMMIT ETMEYIN.
# ============================================================================

# --- Cuzdan / kimlik (canliya gecince gerekli) ---
PRIVATE_KEY=0xYOUR_POLYGON_PRIVATE_KEY
PROXY_WALLET_ADDRESS=0x92f867a3fb4a153566be8bdf04dfc555d9ce1e1f
SIGNATURE_TYPE=3          # POLY_1271 (diag_balance ile dogrulandi)

# Opsiyonel L2 creds (yoksa private key'den turetilir)
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=

# --- Sunucular (varsayilanlar yeterli) ---
# CLOB_HOST=https://clob.polymarket.com
# GAMMA_HOST=https://gamma-api.polymarket.com
# RTDS_WS_URL=wss://ws-live-data.polymarket.com

# --- Sinyal parametreleri ---
ASSET=btc
TIMEFRAME_MIN=5
EDGE_MARGIN=0.05         # fee dusulmus min beklenen deger (USDC/share) -> sinyal esigi
VOL_WINDOW_SEC=90        # oynaklik (sigma) tahmin penceresi
MIN_TICKS=20             # sigma icin gereken min tick
MIN_SEC_TO_CLOSE=20      # kapanisa bu kadar kaladan az ise girme
MIN_ELAPSED_SEC=15       # pencere basindan bu kadar gecmeden girme
ORDER_SHARES=5           # pozisyon boyutu (share)

# --- Web dashboard ---
DASHBOARD_PORT=8091      # limit-trader 8090, clone-trader 8080 -> 8091
# Public IP'de acacaksan token koy: http://IP:8091/?key=<token>
# DASHBOARD_TOKEN=

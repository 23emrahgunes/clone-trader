# =============================================================================
# Polymarket BTC 5 Dakika CLOB Market-Maker Botu -- ornek ortam dosyasi
# Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.  ASLA .env'i commit etmeyin.
# =============================================================================

# --- Cuzdan / Kimlik (ZORUNLU, hassas) ---------------------------------------
# Polygon cuzdaninizin ozel anahtari (0x...). Bu anahtar emirleri imzalar.
PRIVATE_KEY=0xYOUR_POLYGON_PRIVATE_KEY

# CLOB "funder" adresi = fonlarin/pozisyonlarin durdugu Polymarket cuzdan adresi.
# EOA (SIGNATURE_TYPE=0) icin bu genelde ozel anahtarin kendi adresidir.
PROXY_WALLET_ADDRESS=0xYOUR_POLYMARKET_WALLET_ADDRESS

# Polygon RPC endpoint (opsiyonel; SDK cogu islemi CLOB REST uzerinden yapar).
RPC_URL=https://polygon-rpc.com
CHAIN_ID=137

# --- Imza tipi (ZORUNLU dogru secim) -----------------------------------------
# Bu bot py-clob-client-v2 (fork) kullanir; gecerli degerler 0, 1, 2, 3:
#   0 = EOA               -> anahtarin kendi cuzdanindan islem (funder = kendi adresiniz)
#   1 = POLY_PROXY        -> Polymarket email / Magic login proxy cuzdani
#   2 = POLY_GNOSIS_SAFE  -> MetaMask / tarayici cuzdani Polymarket hesabi (Gnosis Safe)
#   3 = POLY_1271         -> EIP-1271 akilli-kontrat cuzdan imzasi (senin .env.gercek setin bunu kullaniyor)
# Hangisinin senin USDC'ni gordugunu emin olmak icin once: python diag_balance.py
SIGNATURE_TYPE=3

# Funder (proxy) adresi -- canli edge botlarinda kullandigin deger:
# PROXY_WALLET_ADDRESS=0x92f867a3fb4a153566be8bdf04dfc555d9ce1e1f

# --- Opsiyonel L2 API kimlik bilgileri ---------------------------------------
# Ucu de verilirse dogrudan kullanilir; verilmezse ozel anahtardan otomatik turetilir.
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=

# --- Polymarket sunuculari (varsayilanlar genelde yeterli) -------------------
# CLOB_HOST=https://clob.polymarket.com
# GAMMA_HOST=https://gamma-api.polymarket.com

# --- Strateji parametreleri --------------------------------------------------
ASSET=btc
TIMEFRAME_MIN=5
BUY_PRICE=0.01              # 1c limit alim
SELL_PRICE=0.02            # 2c limit satis
ORDER_COUNT=5              # taraf basina (YES/NO) alim emri sayisi

# Emir basina kontrat (share). Polymarket BTC 5dk marketinde min $1 kurali YOK; 5 share gider.
SHARES_PER_ORDER=5

POLL_INTERVAL=0.5          # emir durumu izleme araligi (saniye)
EXPIRY_CANCEL_SECONDS=30   # kapanisa bu kadar kala tum emirleri iptal et
DISCOVERY_RETRY_SECONDS=2  # aktif market bulunamazsa bekleme

# --- Guvenlik anahtari -------------------------------------------------------
# true: GERCEK EMIR GONDERMEZ, tum donguyu (kesif/fill/iptal) simule eder ve loglar.
# false (varsayilan): CANLI -- gercek USDC ile emir gonderir.
DRY_RUN=false

# --- Web dashboard -----------------------------------------------------------
# Bot calisirken tarayicidan izleme panosu (canli market, acik emirler, fill, istatistik).
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8080
# Public IP'de acacaksan bir token koy; panoya http://IP:PORT/?key=<token> ile erisilir.
# DASHBOARD_TOKEN=

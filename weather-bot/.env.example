# ============================================================================
# Weather-Bot -- ornek ortam dosyasi. ".env" olarak kopyalayin. .env'i COMMIT ETMEYIN.
# ============================================================================

# --- Cuzdan / kimlik (canliya gecince gerekli) ---
PRIVATE_KEY=0xYOUR_POLYGON_PRIVATE_KEY
PROXY_WALLET_ADDRESS=0x92f867a3fb4a153566be8bdf04dfc555d9ce1e1f
SIGNATURE_TYPE=3          # POLY_1271

# Opsiyonel L2 creds (yoksa private key'den turetilir)
# CLOB_API_KEY=
# CLOB_API_SECRET=
# CLOB_API_PASSPHRASE=

# --- Sunucular (varsayilanlar yeterli) ---
# CLOB_HOST=https://clob.polymarket.com
# GAMMA_HOST=https://gamma-api.polymarket.com

# --- Strateji ---
CITIES=nyc,chicago,la,miami,sf   # 5 ABD sehri (net NWS CLI resolution)
EDGE_MARGIN=0.05                 # min fee-sonrasi beklenen deger -> sinyal
ORDER_SHARES=10                  # pozisyon boyutu (share)
POLL_INTERVAL=30                 # market/veri tarama araligi (sn)
MAX_POS_PER_MARKET=1
FEE_BPS=0                        # weather marketlerinde genelde fee yok (0). Varsa ayarla.

# --- Web dashboard ---
DASHBOARD_PORT=8095              # kripto botlari 8080-8094; weather 8095
# Public IP'de acacaksan token koy: http://IP:8095/?key=<token>
# DASHBOARD_TOKEN=

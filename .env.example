# =============================================================
#  Polymarket Clone Trading Bot - Environment Configuration
#  Copy this file to ".env" and fill in real values.
#  NEVER commit the real ".env" file to git.
# =============================================================

# --- Wallet / Authentication (SENSITIVE) ---
# Polygon private key of the signing EOA (with or without 0x prefix).
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Polymarket Proxy (funder) wallet address that actually holds the USDC.e.
PROXY_WALLET_ADDRESS=0xYOUR_PROXY_WALLET_ADDRESS

# --- Blockchain ---
# Polygon Mainnet RPC endpoint (Alchemy / Infura / QuickNode / public).
RPC_URL=https://polygon-rpc.com
# Chain ID for Polygon Mainnet (leave as 137).
CHAIN_ID=137

# --- Polymarket CLOB ---
# CLOB REST host (leave as default unless testing).
CLOB_HOST=https://clob.polymarket.com
# Signature type — ONLY 0, 1, 2 are valid. Any other value (e.g. 3) makes every
# order fail client-side with "Invalid order inputs".
#   0 = EOA               -> trade from the key's own wallet (funder = self)
#   1 = POLY_PROXY        -> Polymarket email / Magic login proxy wallet
#   2 = POLY_GNOSIS_SAFE  -> MetaMask / browser-wallet Polymarket account (Safe)
SIGNATURE_TYPE=0

# --- CLOB L2 API Credentials (optional) ---
# If all three are set they are used directly; otherwise they are derived from PRIVATE_KEY.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# --- Telegram ---
# Bot token from @BotFather.
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmnOPQRstuVWXyz
# (Optional) Chat ID to push notifications to (defaults to admin id if unset).
TELEGRAM_CHAT_ID=
# Your numeric Telegram user id — the ONLY account allowed to command the bot.
TELEGRAM_ADMIN_ID=123456789

# --- Copy-Trade Target ---
# The whale wallet (proxyWallet) to mirror.
TARGET_WALLET=0xTARGET_WHALE_WALLET_ADDRESS
# Optional: mirror MULTIPLE whales — comma-separated proxy wallets.
# Merged with TARGET_WALLET above; leave empty for a single target.
TARGET_WALLETS=

# --- Safety switch ---
# true = paper mode (track + log only, NO real orders). Set to false to trade live.
DRY_RUN=true

# --- Paper PnL dashboard ---
# Web dashboard port (open this port in the GCP firewall to reach it externally).
DASHBOARD_PORT=8080
# If set, dashboard requires ?key=<token>. Strongly recommended on a public IP.
DASHBOARD_TOKEN=

# --- Business Rules (defaults match .skills; override only if needed) ---
# Fixed USDC value allocated to every copied trade.
FIXED_ALLOCATION_USDC=1.0
# Cancel execution if market price is more than this % above target price.
MAX_SLIPPAGE_PCT=3.0
# Absolute slippage cap in price units (0.03 = 3 cents). Effective cap =
# target + max(pct-based, this). Essential for low-priced markets (0.01-0.05)
# where a percentage is far too tight. Set 0 to use pct only.
MAX_SLIPPAGE_CENTS=0.03
# Polymarket minimum order size in USDC.
MIN_ORDER_USDC=1.0
